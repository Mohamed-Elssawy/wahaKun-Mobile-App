# Local secrets (never commit)
.figma.local
src/config/env.local.ts

# Firebase client config. Download your own from the Firebase console
# (Project settings -> Your apps -> Android) and drop it in android/app/.
# google-services.example.json is committed to show the expected shape.
android/app/google-services.json

# Editor config, per-developer rather than part of the project
.vscode/*
!.vscode/settings.json

# Editor and assistant tooling. Per-machine, and no part of the project.
.claude/
.mcp.json
CLAUDE.md
AGENTS.md
.cursor/
.aider*
.windsurfrules
.github/copilot-instructions.md

# Working notes and drafts, not project deliverables. docs/ ships the two Word
# documents only: the requirements and the system overview.
REFERENCE-NOTES.md
BACKEND-BLOCKERS.md
docs/*.md

# Local dev tooling. These drive the .NET stack and the demo data on one machine,
# with absolute paths to sibling checkouts, so they are no use in a clone.
scripts/*.ps1
scripts/demo-photos/

# Design exports. Regenerated from Figma on demand; ~36 MB of binaries that
# would bloat every clone and can't be diffed.
docs/*.pdf

# Local planning docs — not part of the codebase
FRONTEND-BUILD-PLAN.md
PROMPT-RULEBOOK.md
SYSTEM-SPEC.md
SPRINT-TO-OCT-08.md
VISUAL-DEFECTS.md
