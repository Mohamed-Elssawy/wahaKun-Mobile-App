# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Local secrets (never commit)
.figma.local
src/config/env.local.ts

# Firebase client config. Download your own from the Firebase console
# (Project settings -> Your apps -> Android) and drop it in android/app/.
# google-services.example.json is committed to show the expected shape.
android/app/google-services.json

# Editor config, per-developer rather than part of the project
.vscode/*
!.vscode/settings.json

# Editor and assistant tooling. Per-machine, and no part of the project.
.claude/
.mcp.json
AGENTS.md
.cursor/
.aider*
.windsurfrules
.github/copilot-instructions.md

# Only the three docs a teammate needs ship; everything else is working notes.
/*.md
!/README.md
!/ARCHITECTURE.md
!/CONVENTIONS.md

# Design/process notes and exports: large, go stale, and not needed to run the app.
docs/
design/
scripts/probe/README.md
tools/*/README.md

# Local dev tooling tied to one machine's absolute paths.
scripts/*.ps1
scripts/demo-photos/

# Only postinstall's own two scripts ship; the rest (i18n pipeline, figma tooling, probe, tests) are local for now.
scripts/*
!scripts/setup-env.js
!scripts/install-hooks.js

